# ── Kralice Dashboard configuration ────────────────────────────
# Copy this to .env and fill in real values. Never commit .env.

# Port the dashboard web server listens on
PORT=4200

# Bearer token required on every /api/* request (sent as header
# "x-dashboard-token" or query string "?token=..."). Pick something long
# and random, e.g. `openssl rand -hex 32`. If left blank, /api is UNAUTHENTICATED
# — do not leave this blank if the dashboard is reachable outside localhost
# (e.g. through kralicehome.ddns.net or any reverse proxy).
DASHBOARD_TOKEN=

# Absolute path to the Kralice bot's install directory (the one containing
# modules/, shopping.json, todos.json, worldcup.json, etc. — i.e. the same
# folder as its index.js). The dashboard reads/writes the bot's JSON state
# files directly from here, and dynamically imports modules/worldcup.js and
# modules/weather.js to reuse their live-data fetching logic.
BOT_DIR=/home/kraliceserver/

# PM2 process name of the bot, as registered with `pm2 start ... --name kralice-bot`
PM2_APP_NAME=kralice-bot

# Path to this user's PM2 log directory (defaults to ~/.pm2/logs if unset)
PM2_LOG_DIR=

# Chat ID used for shopping/todo/poll actions triggered from the dashboard
# when no chatId is specified in the request (usually your own Telegram user
# or group id, same format the bot itself uses, e.g. "+123456789" or "-100123...")
DEFAULT_CHAT_ID=@Kralice Alerts

# Docker: default is unix:///var/run/docker.sock. Override only if Docker is
# exposed over TCP instead.
DOCKER_SOCKET=/var/run/docker.sock

# Comma-separated list of systemd services the dashboard is allowed to touch.
# Keep this locked down — the dashboard will refuse any service not in this list.
SYSTEMD_ALLOWED_SERVICES=radarr,sonarr

# How many log lines to pull by default for the various log viewers
DEFAULT_LOG_LINES=200
